{
    "name": "jelly-music-app",
    "private": true,
    "version": "1.0.4",
    "type": "module",
    "packageManager": "yarn@1.22.22",
    "scripts": {
        "dev": "vite",
        "dev:nocache": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "deploy": "tsc -b && vite build && node copy404.js && gh-pages -d dist",
        "dev:desktop": "yarn tauri dev",
        "build:desktop": "yarn tauri build",
        "package:web": "bash ./scripts/web-release.sh",
        "package:desktop:linux": "bash ./scripts/desktop-linux-release.sh",
        "build:desktop:win:arm64": "yarn tauri build -- --target aarch64-pc-windows-msvc",
        "package:desktop:win": "powershell ./scripts/desktop-windows-release.ps1",
        "package:desktop:win:arm64": "powershell ./scripts/desktop-windows-arm64-release.ps1",
        "package:desktop:macos": "bash ./scripts/desktop-macos-release.sh",
        "format": "prettier --write . --ignore-path .gitignore --ignore-path src-tauri/.gitignore",
        "typecheck": "tsc --noEmit -p tsconfig.app.json"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fontsource-variable/inter": "^5.3.0",
        "@jellyfin/sdk": "^1.0.0",
        "@primer/octicons-react": "^19.38.0",
        "@tanstack/query-sync-storage-persister": "^5.103.2",
        "@tanstack/react-query": "^5.103.2",
        "@tanstack/react-query-persist-client": "^5.103.2",
        "@tauri-apps/plugin-window-state": "~2.4.1",
        "@types/m3u8-parser": "^7.2.6",
        "@types/node": "^26.6.2",
        "axios": "^1.20.0",
        "figma-squircle": "^1.1.0",
        "hls.js": "^1.7.3",
        "m3u8-parser": "^7.2.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "7.18.4",
        "react-virtuoso": "^4.18.15"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tauri-apps/cli": "^2.11.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-router-dom": "^5.3.3",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "gh-pages": "^6.3.0",
        "globals": "^17.12.0",
        "prettier": "^3.9.9",
        "typescript": "~7.0.2",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.1",
        "vite-plugin-pwa": "^1.3.0"
    }
}
